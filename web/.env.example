# PostgreSQL 连接串，例如 postgres://user:password@127.0.0.1:5432/wentian
DATABASE_URL=

# 会话 JWT 签名密钥（HS256），至少 16 位；可用 openssl rand -hex 32 生成
AUTH_SECRET=

# OpenAI 兼容接口：默认 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 兼容接口的 API Key；留空时 /api/ai/interpret 返回 503
OPENAI_API_KEY=
